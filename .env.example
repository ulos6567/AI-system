# Database (실제 값은 .env에만 기입, 커밋 금지)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ai_store_ops

# Server
PORT=9532
PUBLIC_DOMAIN=p12.sumzip.com
SESSION_SECRET=
NODE_ENV=development

# JWT (모바일/외부 API)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# External adapters (mock by default)
ADAPTER_POS=mock
ADAPTER_FORECAST=baseline
ADAPTER_PUSH=mock
ADAPTER_ESL=mock
ADAPTER_LOGISTICS=mock
ADAPTER_SIGNAL=mock
ADAPTER_VISION=mock

# 002 Intelligence layer adapters (simulation by default)
ADAPTER_ANOMALY=sim
ADAPTER_IOT=sim
ADAPTER_LLM=mock

# External LLM (AI 경영비서) — 실제 값은 .env 에만, 커밋 금지
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# Frontend
VITE_API_BASE_URL=/api
FRONTEND_PORT=9512
